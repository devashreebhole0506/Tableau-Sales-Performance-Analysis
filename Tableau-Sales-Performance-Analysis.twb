      <aliases enabled='yes' />
      <column caption='Profit Margin' datatype='real' name='[Calculation_1703749977313280]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) != 0 THEN&#13;&#10;    SUM([Profit]) / SUM([Sales])&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Total Orders' datatype='integer' name='[Calculation_1703749977432065]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Order ID])' />
      </column>
      <column caption='Average Oder Value' datatype='real' name='[Calculation_1703749977595906]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF COUNTD([Order ID]) != 0 THEN&#13;&#10;    SUM([Sales]) / COUNTD([Order ID])&#13;&#10;ELSE&#13;&#10;    0&#13;&#10;END' />
      </column>
      <column caption='Sales Year' datatype='integer' name='[Calculation_1703749977731075]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Order Date])' />
      </column>
      <column caption='Discount Band' datatype='string' name='[Calculation_1703749977866244]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Discount] = 0 THEN &quot;No Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.10 THEN &quot;Low Discount&quot;&#13;&#10;ELSEIF [Discount] &lt;= 0.25 THEN &quot;Medium Discount&quot;&#13;&#10;ELSE &quot;High Discount&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Status' datatype='string' name='[Calculation_1703749977997317]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Profit]) &lt; 0 THEN &quot;Loss&quot;&#13;&#10;ELSEIF SUM([Profit]) = 0 THEN &quot;Break-even&quot;&#13;&#10;ELSE &quot;Profitable&quot;&#13;&#10;END' />
      </column>
